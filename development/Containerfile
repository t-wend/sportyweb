###############################################################################
#
# Sportyweb Containerfile
#
###############################################################################

# Official image for elixir, based on erlang and debian
FROM docker.io/library/elixir:1.18.4-otp-27 AS swbase
# Please add the elixir version to the .env files!


# Prevents dialogs asking for user presence while installing packages with apt
ENV DEBIAN_FRONTEND=noninteractive

# Install general dependencies 
# inotify-tools is recommended be installed for phoenix
# build-essential is a meta package to compile c,
#   its required for the elixir package "argon2_elixir"
RUN apt update && apt-get install -y --no-install-recommends \
    inotify-tools \
    build-essential \
    && rm -rf /var/lib/apt/lists/*



# Install dependencies for the document-management-module
# imagemagick: generates thumbnails;
# ocrmypdf: enables full-text search on scanned files
# poppler-utils: pdftotext is used to extract text from pdf files
RUN apt update && apt-get install -y --no-install-recommends \
    imagemagick \ 
    ocrmypdf \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# This policy is set by default, but imagemagick cant generate a thumbnail.
# This was set to address a security vulnerability in GhostScript, 
#  a dependency of imagemagick, but was fixed in version 9.24
# https://www.kb.cert.org/vuls/id/332928/
# currently installed is >10.00.0
RUN sed -i 's~<policy domain="coder" rights="none" pattern="PDF" />~~g' /etc/ImageMagick-6/policy.xml


# Informs the Container Engine about the port used by the webserver
EXPOSE 4000/tcp



# Sets args for the user created in the next step
ARG USERNAME=sportyweb
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Creates the user that is used to run or develop sportyweb 
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID -m -d /workspaces -s /bin/bash $USERNAME



###########################################################
#
# test container
#

FROM swbase AS swtest

# There are some restrictions for Containerfiles for GitHub Actions
#   https://docs.github.com/en/actions/reference/workflows-and-actions/dockerfile-support
#   the user root is required
USER root

# ....


###########################################################
#
# Development Container
#
FROM swbase AS swdev

# Development specific packages
# bash-completion adds autocomplete features to the bash shell
# postgresql-client to provide the commands "psql" or "pg_dump", required for "mix ecto.dump"
# nano is a small editor to quickly change files outside the workspace, inside the container
# awscli provides a s3 cli client
RUN apt update && apt-get install -y --no-install-recommends \
    bash-completion \
    postgresql-client \
    nano \ 
    awscli \
    && rm -rf /var/lib/apt/lists/*


# switching to the unprivileged user
USER sportyweb

WORKDIR /workspaces

# add execution of swdev-helper.sh to .bashrc
RUN echo "source /workspaces/sportyweb/swdev-helper.sh > /dev/null " >> /workspaces/.bashrc

# Install hex.pm for the user
RUN mix local.hex --force

# starts a dummy-process so the container is running, 
#  even when the webserver is not started, so that you can
#  run a shell inside the container.
# SIGTERM isnt enough to end the sleep process under podman 
STOPSIGNAL SIGKILL
CMD [ "sleep", "infinity" ]




