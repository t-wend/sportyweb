#####################################
#
# the '.env' file gets sourced by the SCRIPT_FILE each time it is run
# and is used by the compose.yml to provide env vars!
# feel free to adjust the '.env' file, but not the 'template.env'!
#
#####################################
#####################################
# Script settings
##
# to take advantage of a container-based environment leave this at 'true'
# if set to anything else ('false'),  you need to install requirements manually

USE_CONTAINER=true
# adjust to docker and "docker compose" if you prefer it
CONTAINER_TOOL=podman
COMPOSE_PROVIDER="podman compose"
COMPOSE_FILE_PATH=./development/compose.yaml
CONTAINERFILE_PATH=./development/Containerfile
# folder where the sportyweb repo is located inside the container
CONTAINER_PROJECT_DIR="/workspaces/sportyweb"   
DEV_CONTAINER_NAME=sportyweb-dev
DEV_IMAGE_NAME=localhost/sportyweb-dev
DEV_IMAGE_TAG=latest
DEV_IMAGE_TARGET=swdev


#####################################
# Sportyweb settings
##
#
#MIX_ENV=dev
#SECRET_KEY_BASE=CHANGEME

# if this var exists, the webserver binds in MIX_ENV=dev 0.0.0.0
#   this is set by default in the compose.yaml
#SW_LISTEN_ANY=true
SW_LISTEN_PORT=4000

## Database Settings
POSTGRES_DB=sportyweb-${MIX_ENV}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgresql
POSTGRES_TEST_DB=sportyweb-test

#####################################
# Document Storage Settings
##
## Local
# Doesn't work, has to be changed in config.exs
#DOCUMENT_PATH="uploads/documents" 

## S3
# If this var exists, s3 storage provider is used
# Has to be additionaly changed in config.exs
#USE_S3_STORAGE=true
S3_BUCKET=sportyweb-dev
S3_ACCESS_KEY="sportyweb-s3"
#S3_SECRET_KEY="CHANGEME"
S3_REGION=eu-central
S3_HOST=s3
S3_PATH_STYLE=true
S3_PORT=9000
S3_SCHEME=http
#RUSTFS_CONSOLE_ENABLE=true
RUSTFS_ADDRESS=":9000"
#RUSTFS_CONSOLE_ADDRESS=":9001"