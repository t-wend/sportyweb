# to take advantage of a container-based environment leave this at 'true'
# if set to anything else ('false') you have to install all requirements by hand.
USE_DEV_CONTAINER=true
USE_TEST_CONTAINER=true


# Sportyweb settings
ELIXIR_VERSION=1.18.4
MIX_ENV=dev
#SECRET_KEY_BASE=CHANGEME

# if this var exists, the webserver binds in MIX_ENV=dev 0.0.0.0
# is set by default in the compose.yml
#SW_LISTEN_ANY=
SW_LISTEN_PORT=4000

# Database Settings
POSTGRES_DB=sportyweb-${MIX_ENV}
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=postgresql
DATABASE_URL=ecto://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}

POSTGRES_TEST_DB=sportyweb-test



# Script settings
SCRIPT_ALIAS="swdev"                        # needs to be the same as in swdev-helper.sh
SCRIPT_FILE="swdev.sh"
CONTAINER_TOOL=podman
COMPOSE_FILE_PATH=./development/compose.yml
CONTAINERFILE_PATH=./development/Containerfile
DEV_CONTAINER_NAME=sportyweb-dev
DEV_IMAGE_NAME=localhost/sportyweb-dev
DEV_IMAGE_TAG=latest
DEV_IMAGE_TARGET=swdev

# inotifywatch is from package inotify-tools,
#	inotify-tools cannot be located by the command "which"
REQUIRED_PACKAGES="git gcc inotifywatch"

# commands from recommended packages to be checked 
# from package: postgresql-client poppler-utils imagemagick ------
RECOMMENDED_PACKAGES="pg_dump     pdfinfo       convert     ocrmypdf"
